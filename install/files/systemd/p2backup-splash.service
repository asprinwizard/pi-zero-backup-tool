[Unit]
Description=P2 Backup boot splash ("Starting up...")
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Before=p2backup.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONPATH=/opt/p2backup/src
ExecStart=/usr/bin/python3 -m p2backup.splash show starting
# Shown when the system stops this unit during shutdown or reboot.
ExecStop=/usr/bin/python3 -m p2backup.splash show stopping
TimeoutSec=20

[Install]
WantedBy=sysinit.target
