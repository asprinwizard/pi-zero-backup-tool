#!/bin/sh
# initramfs local-premount script: one-time shrink of the root partition and
# creation of the data partition. Runs before root is mounted.
#
# Only acts when the kernel command line contains "p2bshrink". The first
# thing it does is remove that token from cmdline.txt, so it can never run
# on a later boot or cause a boot loop. A marker in /run stops it running
# twice within the same boot (local-premount can be invoked more than once).
#
# If the kernel cannot re-read the new partition table, the script reboots
# so the system comes up with the new layout. The log is saved to the boot
# partition (p2b-shrink.log) so it survives that reboot; s31 collects it.
#
# Numbers below were filled in by install.py (s30) from the live partition
# table. If the table no longer matches, it does nothing.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

grep -qw p2bshrink /proc/cmdline || exit 0
[ -e /run/p2b-shrink.ran ] && exit 0
: >/run/p2b-shrink.ran

. /scripts/functions

DISK=@DISK@
BOOT_DEV=@BOOT_DEV@
ROOT_DEV=@ROOT_DEV@
P2_START=@P2_START@
P2_SECTORS=@P2_SECTORS@
P3_START=@P3_START@
P3_SECTORS=@P3_SECTORS@
FS_SIZE=@FS_SIZE@
SYS=/sys/block/${DISK#/dev/}

mkdir -p /run/initramfs
LOG=/run/initramfs/p2b-shrink.log

say() {
    echo "p2b-shrink: $*" >>"$LOG"
    log_warning_msg "p2b-shrink: $*"
}

# Copy the log to the boot partition so it survives a reboot.
save_log() {
    mkdir -p /run/p2b-boot
    if mount -t vfat "$BOOT_DEV" /run/p2b-boot 2>/dev/null; then
        cp "$LOG" /run/p2b-boot/p2b-shrink.log
        sync
        umount /run/p2b-boot
    fi
}

give_up() {
    say "FAILED: $* (partition table left unchanged unless noted)"
    save_log
    exit 0
}

say "starting"

# Wait for the SD card partitions to appear.
i=0
while [ ! -b "$ROOT_DEV" ] || [ ! -b "$BOOT_DEV" ]; do
    i=$((i + 1))
    [ "$i" -gt 100 ] && give_up "devices did not appear"
    sleep 0.1
done

# 1. Remove the trigger token first.
mkdir -p /run/p2b-boot
mount -t vfat "$BOOT_DEV" /run/p2b-boot || give_up "could not mount boot partition"
sed -i 's/ p2bshrink//g; s/p2bshrink //g; s/p2bshrink//g' /run/p2b-boot/cmdline.txt
sync
umount /run/p2b-boot
say "trigger removed from cmdline.txt"

# 2. Sanity checks against the numbers install.py saw.
[ "$(cat "$SYS/${DISK#/dev/}p2/start")" = "$P2_START" ] || give_up "p2 start changed"
[ -e "$SYS/${DISK#/dev/}p3" ] && give_up "p3 already exists"
sfdisk -d "$DISK" 2>/dev/null | grep -q "^${DISK}p3 " && give_up "p3 already exists on disk"

# 3. Check and shrink the filesystem (leaves a margin below the new partition size).
e2fsck -fy "$ROOT_DEV" >>"$LOG" 2>&1
rc=$?
[ "$rc" -le 1 ] || give_up "e2fsck returned $rc"
say "shrinking filesystem to $FS_SIZE (this can take a few minutes)"
# -f is required: the Pi has no RTC, so in the initramfs the clock is far in
# the past. e2fsck's "last checked" stamp then looks older than the last
# mount time and resize2fs would refuse with "Please run e2fsck -f first",
# even though e2fsck -f has just passed above.
resize2fs -f "$ROOT_DEV" "$FS_SIZE" >>"$LOG" 2>&1 || give_up "resize2fs failed"

# 4. Shrink p2 and append p3. sfdisk keeps the disk identifier, so
#    root=PARTUUID=... stays valid.
say "resizing partition 2"
echo "$P2_START,$P2_SECTORS" | sfdisk --no-reread --no-tell-kernel -N 2 "$DISK" >>"$LOG" 2>&1 \
    || give_up "sfdisk could not resize p2 (filesystem already shrunk; system still boots)"
say "creating partition 3"
echo "$P3_START,$P3_SECTORS,7" | sfdisk --no-reread --no-tell-kernel --append "$DISK" >>"$LOG" 2>&1 \
    || give_up "sfdisk could not add p3 (p2 already shrunk; system still boots)"

say "done"
if blockdev --rereadpt "$DISK" >>"$LOG" 2>&1; then
    save_log
    exit 0
fi
# The kernel still has the old table in memory. Reboot so the system comes up
# with the new layout (the trigger token is already gone, so this runs once).
say "kernel could not re-read the partition table; rebooting to load it"
save_log
sync
reboot -f
echo b >/proc/sysrq-trigger
sleep 5
exit 0
